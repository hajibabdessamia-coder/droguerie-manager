generator client {
  provider      = "prisma-client-js"
  // native: منصة التطوير الحالية (Windows). windows/darwin/darwin-arm64: منصات تطبيق سطح
  // المكتب المُعبّأ (Electron) — يضمن توفر محرك Prisma الصحيح داخل كل حزمة مُصدَّرة
  binaryTargets = ["native", "windows", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // ملف SQLite محلي — راجع .env
}

// ============================================================
// المستخدمون والصلاحيات
// ============================================================

// Role: ADMIN (صلاحية كاملة) | SELLER (بيع فقط، لا حذف، لا تعديل أسعار إلا بإذن)
// SQLite connector doesn't support Prisma enums — see src/common/enums.ts for the app-level values.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SELLER")
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false) // يُجبر تغيير كلمة السر عند أول تسجيل دخول (يُستخدم لحساب الإدارة الافتراضي المزروع)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales      Sale[]
  saleReturns SaleReturn[]
  purchases  Purchase[]
  auditLogs  AuditLog[]
  priceOverridesGranted PriceOverrideGrant[] @relation("GrantedBy")

  @@map("users")
}

// إذن مؤقت من المدير للبائع بتعديل سعر منتج معين ضمن عملية بيع محددة
model PriceOverrideGrant {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  grantedBy String
  grantedByUser User @relation("GrantedBy", fields: [grantedBy], references: [id])
  createdAt DateTime @default(now())

  @@map("price_override_grants")
}

// ============================================================
// المنتجات
// ============================================================

model Manufacturer {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("manufacturers")
}

// فئة منتج قابلة للإنشاء والتسمية والحذف بالكامل من طرف المستخدم (تُدار من الإعدادات)
// — تحل محل تصنيف GROUP_1..GROUP_4 الثابت السابق، وتُستخدم لتبويب نقطة البيع
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

// وحدة قياس المنتج (قطعة، كرتون، كيلوغرام...) قابلة للتخصيص الكامل من طرف المستخدم
// بدل أي وحدات مبرمجة ثابتاً — تُدار من الإعدادات بنفس أسلوب Category
model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("units")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  imageUrl         String?
  internalCode     String    @unique
  barcode          String?   @unique // EAN-13 (13 رقماً) — راجع products/barcode.util.ts للتوليد والتحقق
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitId           String?
  unit             Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  manufacturerId   String?
  manufacturer     Manufacturer? @relation(fields: [manufacturerId], references: [id])

  purchasePrice    Decimal
  retailPrice      Decimal // سعر التقسيط
  wholesalePrice   Decimal // سعر الجملة

  quantity         Int       @default(0)
  minStock         Int       @default(0)
  notes            String?

  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  saleItems        SaleItem[]
  saleReturnItems  SaleReturnItem[]
  purchaseItems    PurchaseItem[]
  stockMovements   StockMovement[]

  @@index([name])
  @@map("products")
}

// سجل كل حركة مخزون (بيع، شراء، تصحيح يدوي) لتفسير أي تغيير في الكمية
// type: SALE | PURCHASE | ADJUSTMENT — انظر src/common/enums.ts
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  quantity  Int      // موجب أو سالب حسب الاتجاه
  reason    String?
  createdAt DateTime @default(now())

  @@map("stock_movements")
}

// ============================================================
// الزبائن والموردون
// ============================================================

// type: WHOLESALE (جملة) | RETAIL (تقسيط) — انظر src/common/enums.ts
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  type      String   @default("RETAIL")
  balance   Decimal  @default(0) // موجب = دين على الزبون
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
  @@map("customers")
}

model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal
  note       String?
  createdAt  DateTime @default(now())

  @@map("customer_payments")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  balance   Decimal  @default(0) // موجب = دين على المحل للمورد
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([name])
  @@map("suppliers")
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal
  note       String?
  createdAt  DateTime @default(now())

  @@map("supplier_payments")
}

// ============================================================
// المبيعات (نقطة البيع)
// ============================================================

// invoiceType: TICKET (ورقة حساب بسيطة) | LEGAL (فاتورة قانونية)
// paymentMethod: CASH | CREDIT (على الحساب، يزيد رصيد الزبون) — انظر src/common/enums.ts
model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  invoiceType   String        @default("TICKET")

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])

  subtotal      Decimal
  discount      Decimal       @default(0)
  taxRate       Decimal       @default(0) // TVA %
  taxAmount     Decimal       @default(0)
  total         Decimal
  amountPaid    Decimal
  changeDue     Decimal       @default(0)
  paymentMethod String        @default("CASH")

  items         SaleItem[]
  priceOverrideGrants PriceOverrideGrant[]
  returns       SaleReturn[]

  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

// priceType: WHOLESALE | RETAIL | CUSTOM (سعر معدّل يدويا من طرف المدير) — انظر src/common/enums.ts
model SaleItem {
  id         String    @id @default(cuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Decimal
  priceType  String
  total      Decimal

  returnItems SaleReturnItem[]

  @@map("sale_items")
}

// فاتورة إرجاع مرتبطة بفاتورة بيع أصلية (لا تُعدَّل الفاتورة الأصلية ولا تُحذف) —
// تسمح بإرجاع جزئي (سطر واحد أو أكثر بكمية أقل من المباعة)، وتُحسب حصتها من خصم/ضريبة
// الفاتورة الأصلية بالتناسب مع قيمة السطور المرتجعة (subtotal المرتجع / subtotal الفاتورة).
// عمداً بلا onDelete: Cascade من جهة Sale حتى يمنع Prisma حذف فاتورة لها إرجاعات مسجَّلة
// (راجع SalesService.remove — يعكس المخزون بالكامل فيكرر إرجاع الكميات لو سُمح بالحذف)
model SaleReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  reason        String?

  subtotal      Decimal // مجموع سطور الإرجاع قبل حصة الخصم/الضريبة
  discountShare Decimal  @default(0)
  taxShare      Decimal  @default(0)
  total         Decimal // المبلغ الفعلي المسترجع = subtotal - discountShare + taxShare

  items         SaleReturnItem[]

  createdAt     DateTime @default(now())

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItemId   String
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])

  quantity     Int
  unitPrice    Decimal
  total        Decimal

  @@map("sale_return_items")
}

// ============================================================
// المشتريات
// ============================================================

model Purchase {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  invoiceRef String?  // رقم فاتورة المورد إن وجد
  total      Decimal
  date       DateTime @default(now())

  items      PurchaseItem[]

  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  quantity      Int
  purchasePrice Decimal
  total         Decimal

  @@map("purchase_items")
}

// ============================================================
// إعدادات المحل (تُستخدم في رأس الفاتورة القانونية)
// ============================================================

model StoreSettings {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String?
  address  String?
  phone    String?
  ifNumber String? // IF
  ice      String? // ICE
  rc       String? // RC
  patente  String?
  defaultTaxRate Decimal @default(0)

  @@map("store_settings")
}

// ============================================================
// سجل العمليات (Audit Log)
// ============================================================

// action: LOGIN | CREATE | UPDATE | DELETE | SALE — انظر src/common/enums.ts
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String   // مثال: "Product", "Sale"
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// النسخ الاحتياطي والتنبيهات
// ============================================================

// status: SUCCESS | FAILED — انظر src/common/enums.ts
model Backup {
  id        String   @id @default(cuid())
  filePath  String
  sizeBytes Int?
  status    String
  createdAt DateTime @default(now())

  @@map("backups")
}

// type: LOW_STOCK | EXPIRY | BACKUP_READY — انظر src/common/enums.ts
model Alert {
  id        String   @id @default(cuid())
  type      String
  message   String
  isRead    Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("alerts")
}

// ============================================================
// الترخيص والفترة التجريبية (المرحلة 12) — صف واحد فقط لكل تثبيت،
// بنفس نمط StoreSettings (upsert بمعرّف ثابت "default")
// ============================================================

model AppLicense {
  id                   String    @id @default(cuid())
  // مرساة زمنية أحادية الاتجاه (لا تتراجع أبداً) تُستخدم لكشف إرجاع ساعة النظام
  // للوراء لإطالة الفترة التجريبية — راجع license.service.ts
  trialStartedAt       DateTime  @default(now())
  trialHighWaterMark   DateTime  @default(now())
  clockAnomalyDetected Boolean   @default(false)
  // نص الترخيص الخام (base64url لِـ payload + signature) بعد التفعيل، فارغ أثناء الفترة التجريبية
  licenseKey           String?
  activatedAt          DateTime?
  // HMAC على حقول الفترة التجريبية (بمفتاح مشتق من معرّف الجهاز) — يكشف تعديلاً
  // يدوياً مباشراً على هذا الصف عبر أداة تصفح SQLite، وليس بديلاً عن توقيع الترخيص
  integrityHash        String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("app_license")
}
