# ملف قاعدة بيانات SQLite محلي (المسار نسبي لمجلد backend/prisma)
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=3001

# نطاقات الواجهة الأمامية المسموح لها بالاتصال (مفصولة بفاصلة)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app"

# الرابط العام للخادم نفسه (يُستخدم في بناء روابط الملفات عند التخزين المحلي)
PUBLIC_URL="http://localhost:3001"

# local (تخزين على قرص الخادم، للتطوير فقط) أو supabase (تخزين سحابي دائم، مطلوب للإنتاج على Render)
STORAGE_PROVIDER="local"
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
