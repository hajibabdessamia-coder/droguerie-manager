# --- تطوير محلي (Docker Postgres) ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_manager?schema=public"

# --- إنتاج (Supabase) ---
# رابط Supabase المجمّع (Connection Pooling، المنفذ 6543) — يُستخدم أثناء تشغيل الخادم
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# رابط Supabase المباشر (المنفذ 5432) — يُستخدم فقط عند تنفيذ prisma migrate (اتركه فارغاً محلياً إن لم تستخدم Supabase)
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=3001

# نطاقات الواجهة الأمامية المسموح لها بالاتصال (مفصولة بفاصلة)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app"

# الرابط العام للخادم نفسه (يُستخدم في بناء روابط الملفات عند التخزين المحلي)
PUBLIC_URL="http://localhost:3001"

# local (تخزين على قرص الخادم، للتطوير فقط) أو supabase (تخزين سحابي دائم، مطلوب للإنتاج على Render)
STORAGE_PROVIDER="local"
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
